# Variable names only. Copy to server/.env and fill in values (see README.md for details).
# Empty values fall back to the defaults noted below.

# default 4000
PORT=
# development | test | production (default development)
NODE_ENV=
DATABASE_URL=
# at least 32 random characters
JWT_SECRET=
# default 7
JWT_EXPIRES_IN_DAYS=
# default http://localhost:5173
CLIENT_ORIGIN=
# default uploads (relative to server/). Never serve this folder.
UPLOAD_DIR=

# Gmail (optional; the Gmail endpoints answer 503 until all four are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# must match an authorized redirect URI in Google Cloud, ending in /api/gmail/callback
GOOGLE_REDIRECT_URI=
# base64 of 32 random bytes, used to encrypt refresh tokens at rest
GMAIL_TOKEN_ENCRYPTION_KEY=

# AI job scoring and documents (optional; with no provider jobs get only the skill-overlap score and are flagged llm_failed)
# anthropic | ollama. Empty = anthropic if ANTHROPIC_API_KEY is set, otherwise AI is off.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# default is set in src/config/ai.js
ANTHROPIC_MODEL=

# Local testing with Ollama (AI_PROVIDER=ollama). Nothing is sent to a hosted service.
# Required with AI_PROVIDER=ollama. Must already be pulled, e.g. qwen2.5:7b-instruct (run: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:7b-instruct
# default http://localhost:11434
OLLAMA_BASE_URL=
# default 600000 (10 minutes; a 7B model on CPU only manages ~7 tokens/s, so long documents take minutes)
OLLAMA_TIMEOUT_MS=
